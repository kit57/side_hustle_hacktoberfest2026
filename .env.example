# Copy to .env. With nothing set, the app runs on the mock backend and SQLite.

# mock | tinker | openai
LLM_BACKEND=mock

# --- Tinker (fine-tuned open-weight model) ---
TINKER_API_KEY=
TINKER_BASE_MODEL=Qwen/Qwen3.5-4B
# Printed by `python -m training.train`. Empty = sample from the base model.
TINKER_MODEL_PATH=

# --- Any OpenAI-compatible server, e.g. Ollama on this machine ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma3:4b

# --- Backboard (optional per-restaurant glossary memory) ---
BACKBOARD_API_KEY=

# Public origin, used in the QR codes.
BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql://user:pass@host/db
